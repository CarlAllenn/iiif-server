{
  // Max enforcement: every rule on. Line length is raised to 120 to match
  // yamllint; tables and code blocks are exempt (spec tables are wide by
  // nature and reflowing them destroys them).
  "config": {
    "default": true,
    "line-length": {
      "line_length": 120,
      "tables": false,
      "code_blocks": false
    }
  },
  "globs": ["**/*.md"],
  // .git/**: the glob engine traverses VCS internals, and the lefthook
  // remote cache (.git/info/lefthook-remotes/) contains markdown that isn't
  // ours to lint.
  "ignores": ["target/**", "node_modules/**", ".git/**"]
}
